{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trading Terminal",
  "version": "0.0.1",
  "identifier": "dev.tradingterminal.oss",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Trading Terminal", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all" }
}
